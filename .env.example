# Required for production-quality RPC performance.
# Use a Quicknode Solana mainnet HTTPS endpoint.
QUICKNODE_RPC_URL="https://example.solana-mainnet.quiknode.pro/YOUR_TOKEN/"

# Optional client-side RPC used by wallet-adapter ConnectionProvider.
# This URL is visible in the browser. Use public RPC or a browser-safe endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional. Defaults to https://api.kamino.finance.
KAMINO_API_BASE_URL="https://api.kamino.finance"

# Safety limit for automatic route planning. UI can override per request.
MAX_DEPOSIT_AMOUNT="100"
